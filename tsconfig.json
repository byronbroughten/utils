{
  // The utils program: src/ with its tests, checked under the same module rules the build emits with.
  "extends": "@byronbroughten/code-style/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
